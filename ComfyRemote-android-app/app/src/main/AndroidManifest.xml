<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!--
      Android 11+ hides other installed apps unless they are declared here. Without
      this block the "Browse with" chooser can only show default handlers; with it,
      every installed file manager / gallery / provider is listed.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.GET_CONTENT" />
            <data android:mimeType="*/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.OPEN_DOCUMENT" />
            <data android:mimeType="*/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.PICK" />
            <data android:mimeType="image/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="image/*" />
        </intent>
        <!-- Launcher query: needed to SEE file managers that expose no picker at all
             (File Manager+ is one), so the app can offer to open them directly. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <package android:name="com.alphainventor.filemanager" />
        <package android:name="com.google.android.documentsui" />
        <package android:name="com.android.documentsui" />
        <package android:name="com.google.android.apps.nbu.files" />
        <package android:name="nextapp.fx" />
        <package android:name="pl.solidexplorer2" />
        <package android:name="com.lonelycatgames.Xplore" />
        <package android:name="me.zhanghai.android.files" />
        <package android:name="com.mixplorer" />
        <package android:name="com.mixplorer.silver" />
        <package android:name="com.estrongs.android.pop" />
        <package android:name="com.ghisler.android.TotalCommander" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Comfy Remote"
        android:supportsRtl="true"
        android:theme="@style/Theme.ComfyRemote"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.ComfyRemote">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Share-in. File managers that cannot be reached by any picker can still
              share, so Comfy Remote registers as a share target: browse the SMB share
              in File Manager+, Share -> Comfy Remote, and the image arrives as a ref.
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>
    </application>
</manifest>
